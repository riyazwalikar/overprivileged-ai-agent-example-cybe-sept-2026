# Meridian Space Tours demo — environment reference.
# Run `make env` (scripts/gen_env.sh) to generate a real .env from this file.
# Do not put real credentials here. The only real secret is the locally
# generated INTERNAL_OPS_TOKEN, and it only unlocks the local ops-internal.

# ---- LLM inference ----
# http    = any OpenAI-compatible /chat/completions endpoint (default: DeepSeek).
# bedrock = Amazon Bedrock Converse API (IAM, no API key in env).
LLM_PROVIDER=http
MODEL_ID=deepseek-chat
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
# Bedrock alternative (IAM; Anthropic models need the AWS use-case form):
# LLM_PROVIDER=bedrock
# MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
AWS_REGION=us-east-1
AWS_PROFILE=myiamadmin
TEMPERATURE=0
TOP_P=1

# ---- Public access ----
# HTTP Basic auth on the support-agent (all routes except /healthz).
# Password lives in secrets/basic_auth_password (mounted read-only into the
# container) so the RCE `;env` dump does not surface it. User is not secret.
BASIC_AUTH_USER=comet
BASIC_AUTH_PASSWORD=
BASIC_AUTH_PASSWORD_FILE=/run/secrets/basic_auth_password

# ---- Internal service (the payoff) ----
INTERNAL_OPS_URL=http://ops-internal:9000
INTERNAL_OPS_TOKEN=change-me-run-make-env

# ---- Decoy secrets (obviously fake, non-functional; shown in the env dump) ----
STRIPE_API_KEY=sk_live_000000000000000000000000
SENTRY_DSN=https://00000000000000000000000000000000@o0.ingest.example.com/0
